# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
# Model used for intake analysis (must support structured outputs / json_schema).
OPENAI_MODEL=gpt-4o-mini

# --- Database (Prisma + SQLite) ---
# Relative paths are resolved from backend/prisma/.
DATABASE_URL="file:./dev.db"

# --- Backend server ---
PORT=3000
HOST=0.0.0.0

# --- Auth ---
# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- Frontend ---
# Base URL the React app uses to reach the backend API.
VITE_API_URL=http://localhost:3000
