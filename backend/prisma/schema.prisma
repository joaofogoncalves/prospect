// Prisma schema — https://pris.ly/d/prisma-schema
// SQLite datasource. After editing models, run:
//   npm run db:migrate --workspace=backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  intakes      Intake[]
}

model Intake {
  id          String   @id @default(cuid())
  title       String
  description String
  budgetRange String
  timeline    String
  industry    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Final AI analysis output (null until analyzed). Arrays stored as JSON.
  summary       String?
  tags          Json?
  riskChecklist Json?
  analyzedAt    DateTime?

  // Analysis lifecycle for the async (background-job + client-polling) flow.
  // pending: never analyzed, nothing running (idle — owner can Generate).
  // processing: a job is running (client polls until it resolves).
  // completed: analyzedAt/summary populated. failed: see analysisError.
  analysisStatus String  @default("pending")
  analysisError  String? // last failure message, surfaced to the poller; cleared on a new run
  // User-initiated re-analyze runs spent on this intake (the on-create analysis
  // does NOT count). Capped at MAX_REANALYSIS in routes/intakes.ts.
  analysisRunCount Int   @default(0)

  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisRequests IntakeAnalysisRequest[]
}

// One row per AI analysis attempt — kept for observability (response times,
// which model/schema was used, the raw response). Trades disk for visibility.
model IntakeAnalysisRequest {
  id           String    @id @default(cuid())
  intakeId     String
  intake       Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  model        String
  schema       Json // the JSON schema sent to the model
  systemPrompt String
  userPrompt   String
  rawResponse  String? // raw content returned by the model (null on failure)
  status       String // "success" | "error"
  error        String?
  startedAt    DateTime // when the request was issued
  completedAt  DateTime? // when the response (or failure) returned
  durationMs   Int? // completedAt - startedAt, for metrics
  createdAt    DateTime  @default(now())
}
